# Stripe — usa claves de test (sk_test_...) hasta que esté listo para producción.
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx

# Verificación de webhooks de Stripe.
# - Local: lo da `stripe listen --forward-to localhost:3000/api/stripe/webhook` (whsec_...).
# - Producción: dashboard.stripe.com → Developers → Webhooks → "Reveal signing secret".
STRIPE_WEBHOOK_SECRET=whsec_xxx
